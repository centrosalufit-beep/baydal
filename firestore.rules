rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Panel: solo usuarios autenticados (creados a mano en la consola de Firebase Auth).
    // El bot usa el Admin SDK desde Cloud Functions y no pasa por estas reglas.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
